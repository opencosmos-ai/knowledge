    "quotes:validate:pilot": "tsx --env-file=.env scripts/normalize-quotes/02-validate-provenance.ts --pilot",
    "quotes:validate:resume": "tsx --env-file=.env scripts/normalize-quotes/02-validate-provenance.ts --resume",
